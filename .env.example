# Copiez ce fichier en .env puis remplacez chaque valeur « changez-moi ».
# Ne mettez jamais de vraie valeur secrète dans ce fichier d'exemple.

# ── Développement local (Docker) ───────────────────────────────────
WEB_PORT=3000
ADMINER_PORT=8080
POSTGRES_DB=teranga
POSTGRES_USER=teranga
POSTGRES_PASSWORD=changez-moi
# DATABASE_URL est construit par docker-compose.yml ; les médias vont dans un volume Docker.

# ── Commun (local et Vercel) ───────────────────────────────────────
# Auth.js — générez une valeur avec : openssl rand -base64 32
AUTH_SECRET=changez-moi
AUTH_TRUST_HOST=true
# Adresse publique du site (liens de partage, QR codes, métadonnées)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Vercel uniquement (ajoutées automatiquement par les intégrations) ─
# Neon : DATABASE_URL (avec pooler) et DATABASE_URL_UNPOOLED (pour les migrations)
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# Vercel Blob : active l'envoi direct des médias
# BLOB_READ_WRITE_TOKEN=

# Compte de démonstration créé par le seed (npm run seed)
SEED_USER_EMAIL=demo@teranga.test
SEED_USER_PASSWORD=changez-moi
